# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
# Get your key from https://fal.ai/dashboard/keys
# The key stays server-side. It is never sent to the browser and never logged.
FAL_KEY=

# Hard monthly spend ceiling in USD. The app refuses to submit jobs past this.
# fal.ai itself has NO native spend cap — this is the only ceiling that exists.
BUDGET_MONTHLY_USD=20

# Per-user monthly ceiling in USD. Set equal to BUDGET_MONTHLY_USD to disable.
BUDGET_PER_USER_USD=5

# Refuse any single job estimated above this. Catches fat-finger resolution errors.
BUDGET_PER_JOB_USD=0.25

# Kill switch. Set to 1 to block all submissions without taking the app down.
KILL_SWITCH=0

# Engine. "fal" (default) spends money on fal.ai. "fake" runs the whole job flow
# with no network and no key, for development. Uncomment to use it.
# RENDER_ENGINE=fake
# How many seconds a fake render takes to complete.
# FAKE_ENGINE_DELAY_S=4

# How long a render may stay in flight before it is failed and its budget released.
# JOB_TIMEOUT_S=480

# Experimental tasks (entourage, skp_material_render) are hidden and refused unless set to 1.
# ENABLE_EXPERIMENTAL_TASKS=

# Where SQLite and generated images live
DATA_DIR=./data
DB_PATH=./data/render_studio.db


# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------

# The shared code that lets someone reach the signup form. Nothing else.
# It decides who may ASK for an account; approval decides who may spend money.
# Leave it empty and signup is disabled outright, rather than open to everyone.
# Make it long and boring — it will end up written on a whiteboard.
OFFICE_ACCESS_CODE=change-me

# The first account created on this address is active and administrator.
# Without it there is nobody to approve the first account and the office is
# locked out of its own app. Set it before anyone signs up.
ADMIN_EMAIL=admin@example.test

# New accounts wait for an administrator to approve them. Set to 0 only if the
# access code on its own is considered enough.
SIGNUP_REQUIRES_APPROVAL=false

# Comma-separated email domains whose new accounts are active at once, with no
# approval step, e.g. AUTO_APPROVE_DOMAINS=example.test,partner.example. Matched
# exactly (sub.example.test is NOT covered) and case-insensitively. Leave empty to
# approve everyone by hand. ADMIN_EMAIL still works the same way either way.
AUTO_APPROVE_DOMAINS=
# Warning: anyone holding the office code can register an address on a listed domain; keep it empty until addresses are verified.

# Minimum password length. Argon2 handles slow hashing; this stops "password1".
PASSWORD_MIN_LENGTH=10

# Cookie `Secure` flag. MUST stay 0 on plain http:// — a Secure cookie is never
# sent over http, so nobody could sign in. Set to 1 the day the app is behind
# https, and note that until then passwords and session cookies cross the LAN
# in cleartext and are readable by anyone on that network with a sniffer.
COOKIE_SECURE=0

# How long a signed-in session lasts before it has to be renewed.
SESSION_DAYS=30
